# Ollama (local model runtime)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llava:13b

# FastAPI backend (once implemented) — base URL the frontend will connect to
# for the SSE/WebSocket agent session described in src/lib/mockEngine.ts and
# src/pages/Settings.tsx. Variable name/prefix is a guess (Vite requires the
# VITE_ prefix to expose a var to frontend code) — confirm once the backend
# and frontend wiring are actually built.
VITE_API_BASE_URL=http://localhost:8000

# Backend service ports referenced by the mock engine's simulated egress log
# (src/lib/mockEngine.ts) — placeholders until the real services exist.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FAISS_HOST=localhost
FAISS_PORT=7001
SANDBOX_EXEC_HOST=localhost
SANDBOX_EXEC_PORT=9000
